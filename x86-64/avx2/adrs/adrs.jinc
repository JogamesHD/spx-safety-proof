    requires = is_arr_init(adrs, 0, 4*8) && 0 <= SPX_ADRS_OFFSET_TREEINDEX && SPX_ADRS_OFFSET_TREEINDEX <= 7,
    ensures = is_arr_init(adrs, 0, 4*8)
