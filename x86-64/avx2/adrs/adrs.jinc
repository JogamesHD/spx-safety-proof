//_JogamesHD_
#[safety =
   {
    requires = is_arr_init(adrs, 0, 4*8) && 0 <= SPX_ADRS_OFFSET_HASHADDR && SPX_ADRS_OFFSET_HASHADDR <= 7,
    ensures = is_arr_init(adrs, 0, 4*8)
   }
 ]
inline
