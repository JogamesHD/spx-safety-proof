//_JogamesHD_ _Question_ Should I make a statement about keypair?
#[safety =
   {
    requires = is_arr_init(adrs, 0, 4*8) && 0 <= SPX_ADRS_OFFSET_KEYPAIRADDR && SPX_ADRS_OFFSET_KEYPAIRADDR <= 7,
    ensures = is_arr_init(adrs, 0, 4*8)
   }
 ]
inline
fn __adrs_get_key_pair_addr(
    reg ptr u32[8] adrs
) -> reg u32
{
    reg u32 keypair = adrs[SPX_ADRS_OFFSET_KEYPAIRADDR];
    return keypair;
}

