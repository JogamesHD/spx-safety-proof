}

//_JogamesHD_
#[safety =
   {
    requires = is_arr_init(adrs, 0, 4*8) && 0 <= SPX_ADRS_OFFSET_TREEHEIGHT && SPX_ADRS_OFFSET_TREEHEIGHT <= 7,
    ensures = is_arr_init(adrs, 0, 4*8)
   }
 ]
inline
fn __adrs_set_tree_height(
