#[safety =
   {
    requires = is_arr_init(adrs, 0, 4*8) && 0 <= SPX_ADRS_OFFSET_CHAINADDR && SPX_ADRS_OFFSET_CHAINADDR <= 7,
    ensures = is_arr_init(adrs, 0, 4*8)
   }
 ]
inline
fn __adrs_set_chain_addr(
