require "sha512_avx/sha512_compress_avx.jinc"
require "sha512_avx/sha512_compress_avx2.jinc"
require "common/sha512_common.jinc"

namespace sha512_hmac_inner {
    param int PREFIXLEN = SHA512_IN + SPX_N;
    require "sha512_absorb/sha512_absorb.jinc"
}

namespace sha512_hmac_outer {
    param int INLEN = SHA512_IN + SHA512_OUT;
    require "sha512_array/sha512_array.jinc"
}

namespace sha512_mgf1_msg {
    param int PREFIXLEN = 3*SPX_N;
    require "sha512_absorb/sha512_absorb.jinc"
}

namespace sha512_mgf1_seed {
    param int INLEN = 2*SPX_N + SHA512_OUT + 4;
    require "sha512_array/sha512_array.jinc"
}



namespace sha512_tl_1n {
    param int INLEN = 22 + SPX_N;
    require "sha512_array/sha512_array.jinc"
    require "sha512_cache/sha512_cache_hash.jinc"
}

namespace sha512_tl_2n {
    param int INLEN = 22 + 2*SPX_N;
    require "sha512_array/sha512_array.jinc"
    require "sha512_cache/sha512_cache_hash.jinc"
}

namespace sha512_compress_wots {
    param int INLEN = 22 + SPX_LEN*SPX_N;
    require "sha512_array/sha512_array.jinc"
    require "sha512_cache/sha512_cache_hash.jinc"
}

namespace sha512_compress_fors {
    param int INLEN = 22 + SPX_K*SPX_N;
    require "sha512_array/sha512_array.jinc"
    require "sha512_cache/sha512_cache_hash.jinc"
}