//_JogamesHD_ Precondition mainly derived from call of _SHA512_blocks_0_ref_array
#[safety =
   {
    requires =
    is_arr_init(pkseed, 0, SPX_N) && SPX_N <= SHA512_IN && //_JogamesHD_ To prevent oob array write in block
    SHA512_IN % 8 == 0 &&
    is_arr_init(Hc, 0, 4*8), //_JogamesHD_ Necessary, so that init_cache can ensure is_arr_init(Hc, 0, 8*12).
    //_JogamesHD_ INLEN == SHA512_IN should be here because of _SHA512_blocks_0_ref_array call, but probably not necessary
    //_JogamesHD_ Since INLEN cannot be referenced here, it is easier to not have the condition
    ensures = is_arr_init(Hc, 0, 8*12) && is_arr_init(pkseed, 0, SPX_N)
   }
 ]
fn sha512_initH_cache(reg ptr u8[96] Hc, reg ptr u8[SPX_N] pkseed) -> reg ptr u8[96]
{
    stack u64[8] H;
    stack u8[SHA512_IN] block;
    reg ptr u64[8] Hp;
    inline int i;

    for i=0 to SHA512_IN/8 { block[:u64 i] = 0; }

    for i=0 to SPX_N { block[i] = pkseed[i]; }

    H = __SHA512_initH_ref();
    
    Hp = H;
    Hp, _ = _SHA512_blocks_0_ref_array(Hp, block);

    for i=0 to 8 { Hc[:u64 4 + i] = Hp[i]; }

    return Hc;
}