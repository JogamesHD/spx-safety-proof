//_JogamesHD_ Precondition mainly derived from call of _SHA512_blocks_0_ref_array
#[safety =
   {
    requires = is_arr_init(Hc, 0, 8*12) && is_arr_init(in, 0, INLEN),
    ensures = is_arr_init(out, 0, 8*8) && is_arr_init(Hc, 0, 8*12)
   }
 ]
// OBS: This function does not have the INLEN parameter defined
// It needs to be instantiated w/ namespaces 
fn sha512_cached(reg ptr u8[64] out, reg ptr u8[INLEN] in, reg ptr u8[96] Hc) -> reg ptr u8[64]
{
    reg u64 bits nblocks inlen offset;
    stack u64[8] H;
    reg ptr u64[8] Hp;
    stack u64[32] sblocks;
    reg ptr u64[32] sblocksp;

    inline int i;

    () = #spill(out);

    bits = INLEN;
    bits += SHA512_IN; // add the number of bytes that were processed to get the cached state Hc
    bits <<= 3;
    () = #spill(bits);
    
    Hp = H;

    // set the state pointer to the cached state
    for i=0 to 8 {
        Hp[i] = Hc[:u64 4 + i];
    }
    
    () = #spill(in);
    Hp, offset = _SHA512_blocks_0_ref_array(Hp, in);

    () = #unspill(in, bits);
    inlen = INLEN % 128;
    sblocks, nblocks = __SHA512_lastblocks_ref_array(in, inlen, offset, bits);
    sblocksp = sblocks;
    Hp, _ = _SHA512_blocks_1_ref(Hp, sblocksp, nblocks);

    () = #unspill(out);
    H = Hp;
    out = __SHA512_store_ref_array(out, H);
    return out;
}