// param int KECCAK_ROUNDS=24;
require "keccakf1600.jinc"

#[safety =
   {
    ensures = is_arr_init(state, 0, 8*25)
   }
 ]
 inline fn __keccak_init_ref1(reg ptr u64[25] state) -> reg ptr u64[25]
{
  inline int i;
  reg u64 t;

  ?{}, t = #set0();
  for i=0 to 25
  { state[i] = t; }

  return state;
}

