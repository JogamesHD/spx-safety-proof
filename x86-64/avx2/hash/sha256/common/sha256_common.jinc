//_JogamesHD_
#[safety =
   {
    res = { H },
    ensures = is_arr_init(H, 0, 4*8)
   }
 ]
inline fn __initH_ref() -> stack u32[8]
{
  stack u32[8] H;

  H[0]  = 0x6a09e667;
  H[1]  = 0xbb67ae85;
  H[2]  = 0x3c6ef372;
  H[3]  = 0xa54ff53a;
  H[4]  = 0x510e527f;
  H[5]  = 0x9b05688c;
  H[6]  = 0x1f83d9ab;
  H[7]  = 0x5be0cd19;

  return H;
}

//_JogamesHD_ Every byte from H is read, so it must be fully initialized.
//_JogamesHD_ _Question_ Should I make statements about the other returned values?
#[safety =
   {
    requires = is_arr_init(H, 0, 4*8),
    ensures = is_arr_init(H, 0, 4*8)
   }
 ]
inline fn __load_H_ref(reg ptr u32[8] H) -> reg u32, reg u32, reg u32, reg u32,
                                            reg u32, reg u32, reg u32, reg u32,
                                            reg ptr u32[8]
{
  reg u32 a b c d e f g h;

  a = H[0];
  b = H[1];
  c = H[2];
  d = H[3];
  e = H[4];
  f = H[5];
  g = H[6];
  h = H[7];

  return a, b, c, d, e, f, g, h, H;
}

//_JogamesHD_
#[safety =
   {
    ensures = is_arr_init(H, 0, 4*8)
   }
 ]
inline fn __store_H_ref(reg ptr u32[8] H, reg u32 a b c d e f g h) -> reg ptr u32[8]
{
  H[0] = a;
  H[1] = b;
  H[2] = c;
  H[3] = d;
  H[4] = e;
  H[5] = f;
  H[6] = g;
  H[7] = h;

  return H;
}

//_JogamesHD_
inline fn __SHR_ref(reg u32 x, inline int c) -> reg u32
{
  reg u32 r;
  r   = x;
  r >>= c;
  return r;
}

//_JogamesHD_
inline fn __ROTR_ref(reg u32 x, inline int c) -> reg u32
{
  reg u32 r;
  r = x;
  _, _, r = #ROR_32(r, c);
  return r;
}

//(x & y) ^ (!x & z)
//_JogamesHD_
inline fn __CH_ref(reg u32 x y z) -> reg u32
{
  reg u32 r s;

  r  =  x;
  r &=  y;
  s  =  x;
  s  = !s;
  s &=  z;
  r ^=  s;

  return r;
}

//(x & y) ^ (x & z) ^ (y & z)
//_JogamesHD_
inline fn __MAJ_ref(reg u32 x y z) -> reg u32
{
  reg u32 r s;

  r  = x;
  r &= y;
  s  = x;
  s &= z;
  r ^= s;
  s  = y;
  s &= z;
  r ^= s;

  return r;
}

// (x >>> 2) ^ (x >>> 13) ^ (x >>> 22)
//_JogamesHD_
inline fn __BSIG0_ref(reg u32 x) -> reg u32
{
  reg u32 r s;

  r  = __ROTR_ref(x, 2);
  s  = __ROTR_ref(x,13);
  r ^= s;
  s  = __ROTR_ref(x,22);
  r ^= s;

  return r;
}

// (x >>> 6) ^ (x >>> 11) ^ (x >>> 25)
//_JogamesHD_
inline fn __BSIG1_ref(reg u32 x) -> reg u32
{
  reg u32 r s;

  r  = __ROTR_ref(x, 6);
  s  = __ROTR_ref(x,11);
  r ^= s;
  s  = __ROTR_ref(x,25);
  r ^= s;

  return r;
}

// (x >>> 7) ^ (x >>> 18) ^ (x >> 3)
//_JogamesHD_
inline fn __SSIG0_ref(reg u32 x) -> reg u32
{
  reg u32 r s;

  r  = __ROTR_ref(x, 7);
  s  = __ROTR_ref(x,18);
  r ^= s;
  s  = __SHR_ref(x,3);
  r ^= s;

  return r;
}

// (x >>> 17) ^ (x >>> 19) ^ (x >> 10)
//_JogamesHD_
inline fn __SSIG1_ref(reg u32 x) -> reg u32
{
  reg u32 r s;

  r  = __ROTR_ref(x,17);
  s  = __ROTR_ref(x,19);
  r ^= s;
  s  = __SHR_ref(x,10);
  r ^= s;

  return r;
}

// Wt = SSIG1(W(t-2)) + W(t-7) + SSIG0(t-15) + W(t-16)
//_JogamesHD_ Only certain parts of W are actually read
#[safety =
   {
    requires = is_arr_init(W, 4*(t-2), 4) && is_arr_init(W, 4*(t-7), 4) &&
    is_arr_init(W, 4*(t-16), 2*4) && 16 <= t && t <= 63,
    ensures = is_arr_init(W, 4*(t-2), 4) && is_arr_init(W, 4*(t-7), 4) &&
    is_arr_init(W, 4*(t-16), 2*4) && is_arr_init(W, 4*t, 4)
   }
 ]
inline fn __Wt_ref(stack u32[64] W, inline int t) -> stack u32[64]
{
  reg u32 wt wt2 wt15;

  wt2  = W[t-2];
  wt   = __SSIG1_ref(wt2);
  wt  += W[t-7];
  wt15 = W[t-15];
  wt15 = __SSIG0_ref(wt15);
  wt  += wt15;
  wt  += W[t-16];

  W[t] = wt;

  return W;
}

// Wt = SSIG1(W(t-2)) + W(t-7) + SSIG0(t-15) + W(t-16)
//_JogamesHD_ The first 4*t bytes must be initialized because of how compress uses it
 #[safety =
   {
    requires = is_arr_init(W, 0, 4*t) && 16 <= t && t <= 63,
    ensures = is_arr_init(W, 0, 4*(t+1))
   }
 ]
inline fn __Wt_ptr_ref(reg ptr u32[64] W, inline int t) -> reg ptr u32[64]
{
  reg u32 wt wt2 wt15;

  wt2  = W[t-2];
  wt   = __SSIG1_ref(wt2);
  wt  += W[t-7];
  wt15 = W[t-15];
  wt15 = __SSIG0_ref(wt15);
  wt  += wt15;
  wt  += W[t-16];

  W[t] = wt;

  return W;
}

//_JogamesHD_ nblocks leads to a case distinction. Precondition then comes from preconditions of
//_JogamesHD_ sha256_compress_avx and sha256_compress_avx2.
#[safety =
   {
    requires = (nblocks == 1) ? (is_arr_init(_H, 0, 16*sha256_avx::STATE_u128_SIZE) && is_arr_init(sblocks, 0, 8*8))
    : (is_arr_init(_H, 0, 16*sha256_avx2::STATE_u128_SIZE) && is_arr_init(sblocks, 0, 8*16)),
    ensures = (nblocks == 1) ? (is_arr_init(_H, 0, 16*sha256_avx::STATE_u128_SIZE) && is_arr_init(sblocks, 0, 8*8))
    : (is_arr_init(_H, 0, 16*sha256_avx2::STATE_u128_SIZE) && is_arr_init(sblocks, 0, 8*16))
   }
 ]
 fn _blocks_1_ref(reg ptr u32[8] _H, reg ptr u32[32] sblocks, reg u64 nblocks) -> reg ptr u32[8], reg ptr u32[32]
{
  inline int t;
  stack u8[64] W1;
  stack u8[128] W2;
  stack ptr u32[8] Hp;
  reg ptr u32[8] H;
  stack ptr u32[32] s_sblocks;

  Hp = _H;

  H = Hp;

  if (nblocks == 1) {
    for t=0 to 8 {
      W1[:u64 t] = sblocks.[:u64 8*t];
    }
    s_sblocks = sblocks;
    
    H = sha256_avx::sha256_compress_avx(H, W1);

    sblocks = s_sblocks;
  } else { // nblocks == 2
    for t=0 to 16 {
      W2[:u64 t] = sblocks.[:u64 8*t];
    }
    s_sblocks = sblocks;
    
    H = sha256_avx2::sha256_compress_avx2(H, W2);

    sblocks = s_sblocks;
  }

  _H = H;
  return _H, sblocks;
}

//_JogamesHD_ Every byte from H is read, so it must be fully initialized
#[safety =
   {
    requires = is_arr_init(H, 0, 4*8),
    ensures = is_arr_init(out, 0, 4*8)
   }
 ]
inline fn __store_ref_array(
  reg ptr u8[32] out,
  stack u32[8] H
) -> reg ptr u8[32]
{
  inline int i;
  reg u32 v;

  for i=0 to 8 { 
    v = H[i];
    v = #BSWAP_32(v); 
    out.[:u32 4*i] = v;
  }
  return out;
}

//_JogamesHD_ Every byte from H is read, so it must be fully initialized
//_JogamesHD_ _Question_ Will need is_mem_init later
#[safety =
   {
    requires = is_arr_init(H, 0, 4*8)
   }
 ]
inline fn __store_ref(
  reg u64 out,
  stack u32[8] H
)
{
  inline int i;
  reg u32 v;

  for i=0 to 8 {
    v = H[i];
    v = #BSWAP_32(v);
    [:u32 out + 4*i] = v;
  }
}
