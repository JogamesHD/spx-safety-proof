//_JogamesHD_ Precondition is derived from preconditions of sha256_compress_avx2 and sha256_compress_avx
#[safety =
   {
    //_JogamesHD_ Conditions from sha256_compress_avx2 call
    requires =
    is_arr_init(_H, 0, 16*sha256_avx2::STATE_u128_SIZE) && is_arr_init(in, 0, INLEN),
    //_JogamesHD_ Not important which namespaces is used in ensures-clause, as STATE_u128_SIZE has the
    //_JogamesHD_ same value in sha256_compress_avx2 and sha256_compress_avx
    ensures = is_arr_init(_H, 0, 16*sha256_avx::STATE_u128_SIZE) && offset == INLEN - (INLEN % 64) &&
    is_arr_init(in, 0, INLEN)
   }
  ]
fn _blocks_0_ref_array(
  reg ptr u32[8] _H,
  reg ptr u8[INLEN] in
) -> reg ptr u32[8], reg u64
{
  inline int t;
  reg u64 offset;
  stack u8[64]  W1;
  stack u8[128] W2;
  reg ptr u32[64] Kp;
  stack ptr u32[8] Hp;
  reg ptr u32[8] H;
  reg u64 inlen;

  offset = 0;
  inlen = INLEN;

  Kp = SHA256_K;
  () = #spill(Kp);
  
  Hp = _H;
  H = Hp;

  // consume as many pairs of consecutive input blocks using AVX2 as possible
  if (INLEN >= 128) {
    while(inlen >= 128) {
      for t=0 to 16 {
        W2[:u64 t] = in.[:u64 offset + 8*t];
      }

      () = #spill(in, offset, inlen);

      H = sha256_avx2::sha256_compress_avx2(H, W2);

      () = #unspill(in, offset, inlen);
      offset += 128;
      inlen -= 128;
    }
  }

  // if one full block remains, consume using AVX
  if (INLEN%128 >= 64) {
    for t=0 to 8 {
      W1[:u64 t] = in.[:u64 offset + 8*t];
    }

    () = #spill(in, offset, inlen);

    H = sha256_avx::sha256_compress_avx(H, W1);

    () = #unspill(in, offset, inlen);
    offset += 64;
  }

  _H = H;
  
  return _H, offset;
}

// OBS: This function does not have the INLEN parameter defined
// It needs to be instantiated w/ namespaces
//_JogamesHD_ inlen bytes are read from in
//_JogamesHD_ The bound on inlen is necessary to prevent oob writes in sblocks
//_JogamesHD_ _Question_ Do I need to make a statement about nblocks?
#[safety =
   {
    requires = is_arr_init(in, offset, inlen) && inlen + offset <= INLEN &&
    inlen <= 127,
    ensures = is_arr_init(sblocks, 0, 4*32)
   }
  ]
inline 
fn __lastblocks_ref_array(reg ptr u8[INLEN] in, reg u64 inlen offset bits) -> stack u32[32], reg u64
{
  stack u32[32] sblocks;
  inline int k;
  reg u64 i j nblocks;
  reg u8 v;

  reg u64 index;

  i = 0;

  // Zero-fill the sblocks array
  for k = 0 to 32 { sblocks[k] = i; }

  // copy in to sblocks
  while(i < inlen)
  { 
    index = offset; index += i;
    v = in[index]; // v = (u8)[in + i];
    sblocks[:u8 i] = v;
    i += 1;
  }

  // set first byte after input to 0x80 
  sblocks[:u8 i] = 0x80;

  // check if one or two blocks are needed
  if(inlen < 56) // 448 / 8 = 56
  { j = (64-8); nblocks = 1; i = 63; }
  else
  { j = (128-8); nblocks = 2; i = 127; }

  while(i >= j)
  { sblocks[:u8 i] = (8u) bits;
    bits >>= 8;
    i -= 1;
  }
  
  return sblocks, nblocks;
}

//_JogamesHD_ Every byte from in is read, so it must be fully initialized
#[safety =
   {
    requires = is_arr_init(in, 0, INLEN) && INLEN%64 + ((INLEN/64)*64) <= INLEN, //_JogamesHD_ Might be redundant, but maybe useful for proofs
    ensures = is_arr_init(out, 0, 4*8) && is_arr_init(in, 0, INLEN)

   }
  ]
// OBS: This function does not have the INLEN parameter defined
// It needs to be instantiated w/ namespaces 
fn sha256(reg ptr u8[32] out, reg ptr u8[INLEN] in) -> reg ptr u8[32]
{
  reg u64 bits nblocks inlen offset;
  stack u32[8] H;
  reg ptr u32[8] Hp;
  stack u32[32] sblocks;
  reg ptr u32[32] sblocksp;
  inline int i;

  () = #spill(out);

  bits = INLEN;
  bits <<= 3;
  () = #spill(bits);

  H = __initH_ref();
  
  () = #spill(in);
  Hp = H;

  for i=0 to INLEN/128 {
    Hp = sha256_avx2::sha256_compress_avx2(Hp, in[i*128 : 128]);
  }
  for i=(INLEN/128)*2 to INLEN/64 {
    Hp = sha256_avx::sha256_compress_avx(Hp, in[i*64 : 64]);
  }
  offset = (INLEN/64)*64;

  () = #unspill(in, bits);
  inlen = INLEN % 64;
  sblocks, nblocks = __lastblocks_ref_array(in, inlen, offset, bits);
  sblocksp = sblocks;
  Hp, _ = _blocks_1_ref(Hp, sblocksp, nblocks);

  () = #unspill(out);
  H = Hp;
  out = __store_ref_array(out, H);
  return out;
}
